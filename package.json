{
  "name": "dsh-overleaf",
  "description": "Embedded Overleaf workbench tab for DeepSeek Harness Web: same-origin reverse proxy, persistent login, AI-assisted editing, compilation diagnostics, and safe bidirectional workspace LaTeX synchronization",
  "version": "0.3.23",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gychen-NJU/dsh-overleaf.git"
  },
  "homepage": "https://github.com/gychen-NJU/dsh-overleaf#readme",
  "bugs": {
    "url": "https://github.com/gychen-NJU/dsh-overleaf/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/smoke-navigation.mjs && node scripts/smoke-login.mjs && node scripts/smoke-texpage.mjs && node scripts/smoke-texpage-socket.mjs && node scripts/smoke-socket-routing.mjs && node scripts/smoke-texpage-output.mjs && node scripts/smoke-output-routing.mjs && node --test scripts/smoke-bib-compat.mjs scripts/smoke-texpage-bib.mjs scripts/smoke-texpage-bib-proxy.mjs scripts/smoke-texpage-tex-sync.mjs scripts/smoke-texpage-tex-proxy.mjs && node scripts/smoke-offline.mjs && node scripts/smoke-live.mjs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
